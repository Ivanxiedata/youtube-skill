#!/bin/sh
# Same gate for every agent and human. Installed by `make setup`.
# make check runs on the working tree, so refuse when that differs from what is being committed.
# ponytail: blocks partial staging; CI on the PR is the authoritative gate either way.
untracked=$(git ls-files --others --exclude-standard)
if ! git diff --quiet || [ -n "$untracked" ]; then
	echo "pre-commit: unstaged changes or untracked files would make the check differ from the commit."
	[ -z "$untracked" ] || { echo "untracked:"; echo "$untracked" | sed 's/^/  /'; }
	echo "pre-commit: stage them (git add) or stash them (git stash -k -u), then commit again."
	exit 1
fi
# -short: tests marked slow (testing.Short()) are skipped here and run in CI.
exec make check TESTFLAGS=-short
