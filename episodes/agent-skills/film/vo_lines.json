[
 {
  "n": 0,
  "beat": 0,
  "voice": "am_michael",
  "start": 0.0,
  "end": 8.254,
  "text": "Agent Skills, explained: you would never make a cook reread five hundred pages to fry one egg, but that is how you prompt your AI agent."
 },
 {
  "n": 1,
  "beat": 0,
  "voice": "am_michael",
  "start": 8.754,
  "end": 13.642,
  "text": "In your kitchen, every rule you wrote sits in one giant binder: the one big prompt."
 },
 {
  "n": 2,
  "beat": 0,
  "voice": "am_michael",
  "start": 13.942,
  "end": 16.168,
  "text": "Your cook reads all of it before every order."
 },
 {
  "n": 3,
  "beat": 0,
  "voice": "am_michael",
  "start": 16.668,
  "end": 18.277,
  "text": "The fix is a recipe box."
 },
 {
  "n": 4,
  "beat": 0,
  "voice": "am_michael",
  "start": 18.577,
  "end": 22.427,
  "text": "Every recipe is a card with a tab: its name, and when to use it."
 },
 {
  "n": 5,
  "beat": 0,
  "voice": "am_michael",
  "start": 22.727,
  "end": 24.291,
  "text": "Your cook reads only the tabs."
 },
 {
  "n": 6,
  "beat": 0,
  "voice": "am_michael",
  "start": 24.591,
  "end": 25.519,
  "text": "Soup is ordered."
 },
 {
  "n": 7,
  "beat": 0,
  "voice": "am_michael",
  "start": 25.819,
  "end": 27.877,
  "text": "He pulls the soup card, and nothing else."
 },
 {
  "n": 8,
  "beat": 0,
  "voice": "am_michael",
  "start": 28.377,
  "end": 30.063,
  "text": "Agent Skills work the same way."
 },
 {
  "n": 9,
  "beat": 0,
  "voice": "am_michael",
  "start": 30.363,
  "end": 37.949,
  "text": "A skill is a folder with one file: skill dot M D. At startup, your agent loads only each skill's name and description."
 },
 {
  "n": 10,
  "beat": 0,
  "voice": "am_michael",
  "start": 38.249,
  "end": 41.043,
  "text": "When a task matches, it reads the full instructions."
 },
 {
  "n": 11,
  "beat": 0,
  "voice": "am_michael",
  "start": 41.343,
  "end": 43.353,
  "text": "Extra files load only if needed."
 },
 {
  "n": 12,
  "beat": 0,
  "voice": "am_michael",
  "start": 43.853,
  "end": 47.135,
  "text": "So it keeps many skills on hand, and a clear head for the job."
 },
 {
  "n": 13,
  "beat": 0,
  "voice": "am_michael",
  "start": 47.635,
  "end": 50.431,
  "text": "It is an open standard, started by Anthropic."
 },
 {
  "n": 14,
  "beat": 0,
  "voice": "am_michael",
  "start": 50.731,
  "end": 52.856,
  "text": "But the lesson is as old as the kitchen."
 },
 {
  "n": 15,
  "beat": 0,
  "voice": "am_michael",
  "start": 53.156,
  "end": 54.692,
  "text": "Don't tell your agent everything."
 },
 {
  "n": 16,
  "beat": 0,
  "voice": "am_michael",
  "start": 54.992,
  "end": 55.88,
  "text": "Tell it where to look."
 },
 {
  "n": 17,
  "beat": 0,
  "voice": "am_michael",
  "start": 56.38,
  "end": 57.782,
  "text": "Subscribe for the next one."
 }
]