[
 {
  "n": 0,
  "beat": 0,
  "voice": "am_michael",
  "start": 0.0,
  "end": 1.949,
  "text": "MCP just stopped remembering you."
 },
 {
  "n": 1,
  "beat": 0,
  "voice": "am_michael",
  "start": 2.249,
  "end": 7.556,
  "text": "You would lose your whole order if your waiter went home, and that is how MCP worked until July."
 },
 {
  "n": 2,
  "beat": 0,
  "voice": "am_michael",
  "start": 8.056,
  "end": 10.519,
  "text": "MCP is how AI apps reach their tools."
 },
 {
  "n": 3,
  "beat": 0,
  "voice": "am_michael",
  "start": 10.819,
  "end": 16.119,
  "text": "An app first shook hands with one server, and could be given a session ID, like a table number."
 },
 {
  "n": 4,
  "beat": 0,
  "voice": "am_michael",
  "start": 16.419,
  "end": 18.009,
  "text": "Only that server knew the order."
 },
 {
  "n": 5,
  "beat": 0,
  "voice": "am_michael",
  "start": 18.309,
  "end": 20.944,
  "text": "On a busy night, the others could not simply step in."
 },
 {
  "n": 6,
  "beat": 1,
  "voice": "am_michael",
  "start": 21.894,
  "end": 25.511,
  "text": "The MCP specification that shipped that day removes both."
 },
 {
  "n": 7,
  "beat": 1,
  "voice": "am_michael",
  "start": 25.811,
  "end": 26.723,
  "text": "No handshake."
 },
 {
  "n": 8,
  "beat": 1,
  "voice": "am_michael",
  "start": 27.023,
  "end": 28.163,
  "text": "No session ID."
 },
 {
  "n": 9,
  "beat": 1,
  "voice": "am_michael",
  "start": 28.463,
  "end": 32.433,
  "text": "Every request is now a complete order slip, so any server can take it."
 },
 {
  "n": 10,
  "beat": 1,
  "voice": "am_michael",
  "start": 32.733,
  "end": 35.15,
  "text": "Need something remembered, like a shopping basket?"
 },
 {
  "n": 11,
  "beat": 1,
  "voice": "am_michael",
  "start": 35.45,
  "end": 38.804,
  "text": "The server hands back a ticket, and the app shows it next time."
 },
 {
  "n": 12,
  "beat": 1,
  "voice": "am_michael",
  "start": 39.304,
  "end": 41.284,
  "text": "So a busy restaurant just adds servers."
 },
 {
  "n": 13,
  "beat": 1,
  "voice": "am_michael",
  "start": 41.584,
  "end": 43.336,
  "text": "Any request can land on any of them."
 },
 {
  "n": 14,
  "beat": 1,
  "voice": "am_michael",
  "start": 43.636,
  "end": 46.212,
  "text": "And if one goes home, the next one takes your order."
 },
 {
  "n": 15,
  "beat": 1,
  "voice": "am_michael",
  "start": 46.712,
  "end": 48.51,
  "text": "The fix was never a better waiter."
 },
 {
  "n": 16,
  "beat": 1,
  "voice": "am_michael",
  "start": 48.81,
  "end": 51.837,
  "text": "It was moving the memory out of his head and onto the slip."
 },
 {
  "n": 17,
  "beat": 1,
  "voice": "am_michael",
  "start": 52.137,
  "end": 55.676,
  "text": "A server that remembers nothing is a server anyone can replace."
 },
 {
  "n": 18,
  "beat": 1,
  "voice": "am_michael",
  "start": 56.176,
  "end": 57.578,
  "text": "Subscribe for the next one."
 }
]